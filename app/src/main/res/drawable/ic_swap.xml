<?xml version="1.0" encoding="utf-8"?>
<!-- Two arrows changing places, upright.
     They used to point left and right, which describes a form with the two
     airports side by side. This one stacks them, so the swap runs up and
     down — and because the movement is vertical it means the same thing in
     Arabic, which is why autoMirrored is gone with it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:pathData="M8,3.5 L8,20.5 M4.5,17 L8,20.5 L11.5,17"
        android:strokeColor="#232522" android:strokeWidth="2"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M16,20.5 L16,3.5 M12.5,7 L16,3.5 L19.5,7"
        android:strokeColor="#232522" android:strokeWidth="2"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
