<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer for Android 13 and up. Same geometry as the foreground,
  one colour throughout: the system recolours this to match the wallpaper, so
  the teal dot has to be part of the silhouette rather than a second colour it
  would flatten anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="28.4"
        android:translateY="28.4">
        <path
            android:pathData="M11,33 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0"
            android:strokeColor="#232522"
            android:strokeWidth="9"
            android:fillColor="#00000000" />
        <path
            android:pathData="M39.5,43.5 L53,57"
            android:strokeColor="#232522"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <path
            android:pathData="M24.5,7 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
            android:fillColor="#232522" />
    </group>
</vector>
