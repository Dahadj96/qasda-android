<?xml version="1.0" encoding="utf-8"?>
<!-- The price chart's mark: three columns of unequal height inside the same
     24dp box, 2dp stroke, round caps as the rest of the set. Drawn as strokes
     rather than filled bars so it sits at the same visual weight as the
     sliders and the calendar beside it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5,20 L5,13 M12,20 L12,8 M19,20 L19,4"
        android:strokeColor="#232522"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
