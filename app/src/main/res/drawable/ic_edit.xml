<?xml version="1.0" encoding="utf-8"?>
<!-- A pencil, for "change what you asked for".

     It replaces the word "Modifier" in the results bar. The word was the
     widest thing in a bar that also has to hold a route and a date, and in
     Arabic it is wider still; a pencil is the same size in all three
     languages. Same geometry as the rest of the set: 24dp box, 2dp stroke,
     round caps and joins. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M4,20 L4,16 L16,4 L20,8 L8,20 Z"
        android:strokeColor="#232522"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M13,7 L17,11"
        android:strokeColor="#232522"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
